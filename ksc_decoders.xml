<!-- Kaspersky Security Center -> Wazuh: декодер событий экспорта в SIEM (Syslog RFC 5424).
     Куда положить и как проверить: INSTRUCTION.md, раздел 5 («Декодер и правила»).
     Приём на сервере Wazuh: раздел 3; настройка экспорта в KSC: раздел 2.
     Пример строки: 1 2026-11-10T11:25:50.855Z  | - TEST_SIEM_CONNECTION [event@23668 et="TEST_SIEM_CONNECTION" etdn="Test Siem Connection"]
     Поля попадают в индекс как data.ksc.* (список — раздел 9). Файл ставится отдельно, существующие декодеры не меняются. -->
<decoder name="kaspersky-ksc">
  <prematch type="pcre2">\[event@23668 </prematch>
</decoder>

<!-- Заголовок RFC 5424: время, источник (сервер KSC или рабочая станция), приложение|версия (KES|11.0.0.0, 1093|1.0.0.0) -->
<decoder name="kaspersky-ksc-fields">
  <parent>kaspersky-ksc</parent>
  <regex type="pcre2">1 (\d{4}-\d\d-\d\dT\S+) (\S*) ([^\s|]*)\|?(\S*) \S+ \S+ \[event@23668 </regex>
  <order>ksc.time, ksc.server, ksc.app, ksc.app_version</order>
</decoder>

<!-- Параметры структурированных данных: порядок в событии не важен, каждый извлекается отдельно -->
<decoder name="kaspersky-ksc-fields">
  <parent>kaspersky-ksc</parent>
  <regex type="pcre2">\bet="((?:[^"\\]|\\.)*)"</regex>
  <order>ksc.event_type</order>
</decoder>

<decoder name="kaspersky-ksc-fields">
  <parent>kaspersky-ksc</parent>
  <regex type="pcre2">\betdn="((?:[^"\\]|\\.)*)"</regex>
  <order>ksc.event_name</order>
</decoder>

<decoder name="kaspersky-ksc-fields">
  <parent>kaspersky-ksc</parent>
  <regex type="pcre2">\bhdn="((?:[^"\\]|\\.)*)"</regex>
  <order>ksc.host</order>
</decoder>

<decoder name="kaspersky-ksc-fields">
  <parent>kaspersky-ksc</parent>
  <regex type="pcre2">\bhip="((?:[^"\\]|\\.)*)"</regex>
  <order>ksc.host_ip</order>
</decoder>

<decoder name="kaspersky-ksc-fields">
  <parent>kaspersky-ksc</parent>
  <regex type="pcre2">\bgn="((?:[^"\\]|\\.)*)"</regex>
  <order>ksc.group</order>
</decoder>

<decoder name="kaspersky-ksc-fields">
  <parent>kaspersky-ksc</parent>
  <regex type="pcre2">\btdn="((?:[^"\\]|\\.)*)"</regex>
  <order>ksc.task</order>
</decoder>

<!-- Текст события после структурированных данных (описание, объект, угроза).
     Строки внутри разделены литералами \r\n -->
<decoder name="kaspersky-ksc-fields">
  <parent>kaspersky-ksc</parent>
  <regex type="pcre2">\[event@23668 (?:[^\]\\]|\\.)*\]\s*(\S.*)$</regex>
  <order>ksc.message</order>
</decoder>

<!-- Поля из текста событий KES: пользователь, процесс, путь, компонент (консоль KSC на русском или английском) -->
<decoder name="kaspersky-ksc-fields">
  <parent>kaspersky-ksc</parent>
  <regex type="pcre2">(?:Пользователь|User): (\S+)</regex>
  <order>ksc.user</order>
</decoder>

<decoder name="kaspersky-ksc-fields">
  <parent>kaspersky-ksc</parent>
  <regex type="pcre2">(?:Название|Name): (.+?)(?:\\r\\n|\s*$)</regex>
  <order>ksc.process</order>
</decoder>

<decoder name="kaspersky-ksc-fields">
  <parent>kaspersky-ksc</parent>
  <regex type="pcre2">(?:Путь к приложению|Application path): (.+?)(?:\\r\\n|\s*$)</regex>
  <order>ksc.process_path</order>
</decoder>

<decoder name="kaspersky-ksc-fields">
  <parent>kaspersky-ksc</parent>
  <regex type="pcre2">(?:Компонент|Component): (.+?)(?:\\r\\n|\s*$)</regex>
  <order>ksc.component</order>
</decoder>
